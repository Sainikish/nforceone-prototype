# Canonical site origin used for metadata, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.nforceone.com

# review  = render pending (unapproved) content with "Pending approval" markers
# production = hide every item that is not approved
NEXT_PUBLIC_CONTENT_MODE=review

# Google Analytics 4 measurement ID (optional)
NEXT_PUBLIC_GA_ID=

# Where validated leads are forwarded as JSON (CRM / mail automation)
LEAD_WEBHOOK_URL=
